# Codex Deck single-VPS example. Copy to /etc/codex-deck.env.
# Keep this file private after adding real paths or URLs.

CODEX_WEB_HOST=127.0.0.1
CODEX_WEB_PORT=8788
# install.sh points this stable path at each release's pinned bundled CLI.
CODEX_BIN=/opt/codex-deck/current/bin/codex
CODEX_HOME=/root/.codex
CODEX_WEB_RUNTIME=app-server

# Shortest private deployment: one owner token, then a long-lived device cookie.
CODEX_WEB_AUTH_MODE=legacy
CODEX_WEB_API_TOKEN_FILE=/var/lib/codex-deck/api-token
CODEX_WEB_COOKIE_PATH=/
CODEX_WEB_COOKIE_SECURE=0
CODEX_WEB_PUBLIC_URL=

CODEX_WEB_DB_PATH=/var/lib/codex-deck/codex.sqlite3
CODEX_WEB_UPLOAD_ROOT=/var/lib/codex-deck/uploads
CODEX_WORKSPACE_ROOT=/

# This intentionally gives writable tasks full authority on this dedicated VPS.
# Keep the HTTP listener private. Set false for the normal Codex sandbox.
CODEX_WEB_UNRESTRICTED_WRITE=true
CODEX_WEB_MAX_CONCURRENT_JOBS=2

CODEX_WEB_INSTANCE_ID=standalone
CODEX_WEB_INSTANCE_SWITCH_URL=
CODEX_WEB_PORTAL_URL=

# Change these if the account does not expose the listed models.
CODEX_WEB_ALLOWED_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
CODEX_WEB_DEFAULT_MODEL=gpt-5.6-sol
